# Contoh env Yuki Rust — salin ke yuki.env lalu sesuaikan.
# Nama variabel SAMA PERSIS dengan Yuki versi Node; nilai rahasia
# (AUTH_SECRET, kunci VAPID, dsb.) salin dari .env instalasi lama
# supaya sesi login user dan langganan push lama tetap berlaku.

# --- Server ---
PORT=3000
HOST=127.0.0.1

# --- Path (arah folder paket ini) ---
YUKI_DIST_DIR=/opt/yuki-rs/app/dist
YUKI_PUBLIC_DIR=/opt/yuki-rs/app/public
MEMORY_DB=/opt/yuki-rs/data/yuki.db
LLM_PROVIDER_CONFIG_FILE=/opt/yuki-rs/.runtime-secrets/llm-providers.json
YUKI_PROVIDER_STATS_FILE=/opt/yuki-rs/data/provider-stats.json
ADMIN_PASSWORD_FILE=/opt/yuki-rs/.runtime-secrets/admin-password.json
TTS_CONFIG_FILE=/opt/yuki-rs/.runtime-secrets/tts-settings.json
YUKI_EMBED_DIR=/opt/yuki-rs/embed
AGENT_WORKSPACE_DIR=/opt/yuki-rs/agent-workspace
YUKI_AGENT_WORKSPACE=/opt/yuki-rs/agent-workspace

# --- Wajib sama dengan instalasi Node lama ---
AUTH_SECRET=ISI_SAMA_DENGAN_YANG_LAMA
# ADMIN_PASSWORD hanya dipakai bila file admin-password.json belum ada.
# ADMIN_PASSWORD=

# --- Web Push (salin dari .env lama) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@ryukomik.web.id

# --- Game (opsional, sama seperti lama) ---
# GAMES_ENABLED=true
# GAMES_PUBLIC=true

# --- TTS (opsional) ---
# KOKORO_URL=http://127.0.0.1:50030
# VOICEVOX_URL=http://127.0.0.1:50021

# --- Embedding (opsional) ---
# Jumlah sesi ONNX paralel (1-4, default 2). Pool 2 memakai RAM kerja
# ±160 MB; pool 1 lebih hemat (±100 MB) dengan latensi chat sedikit
# lebih tinggi.
# YUKI_EMBED_POOL=2
